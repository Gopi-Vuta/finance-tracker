{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pennyfolio-api.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://pennyfolio-api.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/:path*",
      "destination": "https://pennyfolio-api.onrender.com/login/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(api|oauth2|login)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
