# Google OAuth client of type Web application. Never commit the real .env.
# Redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret
# Local-only development password. Change before using any hosted database.
DB_PASSWORD=local-development-only
